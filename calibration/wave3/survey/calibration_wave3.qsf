", "SkinLibrary": "qualtrics", "SkinType": "templated", "Skin": {"brandingId": null, "templateId": "*base", "overrides": null}, "NewScoring": 1}}, {"SurveyID": "SV_b14WSROVHHjCJO8", "Element": "SQ", "PrimaryAttribute": "QID1", "SecondaryAttribute": "Consent", "TertiaryAttribute": null, "Payload": {"QuestionText": "<style>\n.cfx-stem{font-size:16px;line-height:1.55;color:#1a1a1a;max-width:720px;margin:0 auto 14px}\n.cfx-opts{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:10px}\n.cfx-card{display:block;border:1px solid #cfd6dd;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff;transition:border-color .12s,box-shadow .12s}\n.cfx-card:hover{border-color:#9bb0c4}\n.cfx-card.sel{border-color:#1f5fae;box-shadow:0 0 0 2px rgba(31,95,174,.18)}\n.cfx-card.cfx-un{opacity:.55;cursor:not-allowed;background:#f4f5f6;border-style:dashed}\n.cfx-card input{margin-right:10px;transform:translateY(1px)}\n.cfx-attr{font-size:15px;color:#222;margin:2px 0}\n.cfx-an{color:#566}\n.cfx-badge{display:inline-block;font-size:12px;color:#8a4b00;background:#ffe9cc;border-radius:4px;padding:1px 6px;margin-left:6px}\n.cfx-err{display:none;color:#b00020;max-width:720px;margin:0 auto 10px;font-size:15px}\n.cs-wrap{max-width:720px;margin:0 auto;font-size:15px;line-height:1.6;color:#222}\n.cs-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap}\n.cs-btn{font-size:15px;padding:10px 16px;border:1px solid #1f5fae;border-radius:8px;background:#fff;color:#1f5fae;cursor:pointer}\n.cs-btn.on{background:#1f5fae;color:#fff}\n.cs-note{margin-top:12px;color:#444;min-height:20px}\n</style><div class='cs-wrap'><b>Study information</b><br><br>In this study you will make a series of quick choices between consumer products, shown a page at a time, plus a few short questions about the options you saw. The whole study takes about 5 minutes.<br><br>Your responses are anonymous. We collect no personal information beyond the recruitment platform's identifier, which is used only to make sure each person takes the study once. You will be paid through the platform after you finish.<br><br>Taking part is voluntary and you can stop at any time. If you agree to take part, choose “Yes” below and click the arrow to begin.<div class='cs-actions'><button type='button' id='cs-agree' class='cs-btn'>Yes, I consent and wish to begin</button><button type='button' id='cs-decline' class='cs-btn'>No, I do not consent</button></div><div id='cs-note' class='cs-note'></div></div>", "QuestionText_Unsafe": "<style>\n.cfx-stem{font-size:16px;line-height:1.55;color:#1a1a1a;max-width:720px;margin:0 auto 14px}\n.cfx-opts{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:10px}\n.cfx-card{display:block;border:1px solid #cfd6dd;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff;transition:border-color .12s,box-shadow .12s}\n.cfx-card:hover{border-color:#9bb0c4}\n.cfx-card.sel{border-color:#1f5fae;box-shadow:0 0 0 2px rgba(31,95,174,.18)}\n.cfx-card.cfx-un{opacity:.55;cursor:not-allowed;background:#f4f5f6;border-style:dashed}\n.cfx-card input{margin-right:10px;transform:translateY(1px)}\n.cfx-attr{font-size:15px;color:#222;margin:2px 0}\n.cfx-an{color:#566}\n.cfx-badge{display:inline-block;font-size:12px;color:#8a4b00;background:#ffe9cc;border-radius:4px;padding:1px 6px;margin-left:6px}\n.cfx-err{display:none;color:#b00020;max-width:720px;margin:0 auto 10px;font-size:15px}\n.cs-wrap{max-width:720px;margin:0 auto;font-size:15px;line-height:1.6;color:#222}\n.cs-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap}\n.cs-btn{font-size:15px;padding:10px 16px;border:1px solid #1f5fae;border-radius:8px;background:#fff;color:#1f5fae;cursor:pointer}\n.cs-btn.on{background:#1f5fae;color:#fff}\n.cs-note{margin-top:12px;color:#444;min-height:20px}\n</style><div class='cs-wrap'><b>Study information</b><br><br>In this study you will make a series of quick choices between consumer products, shown a page at a time, plus a few short questions about the options you saw. The whole study takes about 5 minutes.<br><br>Your responses are anonymous. We collect no personal information beyond the recruitment platform's identifier, which is used only to make sure each person takes the study once. You will be paid through the platform after you finish.<br><br>Taking part is voluntary and you can stop at any time. If you agree to take part, choose “Yes” below and click the arrow to begin.<div class='cs-actions'><button type='button' id='cs-agree' class='cs-btn'>Yes, I consent and wish to begin</button><button type='button' id='cs-decline' class='cs-btn'>No, I do not consent</button></div><div id='cs-note' class='cs-note'></div></div>", "DataExportTag": "consent_q", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Consent", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID1", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function(){});\nQualtrics.SurveyEngine.addOnReady(function(){\n  var self=this;\n  function ed(k,v){ try{ Qualtrics.SurveyEngine.setEmbeddedData(k,v); }catch(e){} }\n  function $(id){ return document.getElementById(id); }\n  self.hideNextButton();\n  var gs=document.createElement('style'); gs.id='cs-gate-style';\n  gs.textContent='#NextButton,input[id=\\\"NextButton\\\"]{display:none !important;visibility:hidden !important;pointer-events:none !important;}#PreviousButton{display:none !important;}';\n  document.head.appendChild(gs); var done=false;\n  var obs=new MutationObserver(function(){ if(done)return; if(!document.getElementById('cs-gate-style'))document.head.appendChild(gs); });\n  try{ obs.observe(document.head,{childList:true}); }catch(e){}\n  setTimeout(function(){ if(!done)self.hideNextButton(); },500);\n  setTimeout(function(){ if(!done)self.hideNextButton(); },2000);\n  function unlock(){ if(done)return; done=true; try{obs.disconnect();}catch(e){}\n    var g=document.getElementById('cs-gate-style'); if(g&&g.parentNode)g.parentNode.removeChild(g);\n    try{self.showNextButton();}catch(e){}\n    var nb=document.getElementById('NextButton'); if(nb){nb.style.display='';nb.style.visibility='';nb.style.pointerEvents='';nb.removeAttribute('disabled');}\n    setTimeout(function(){try{self.showNextButton();}catch(e){}},120); }\n  function choose(val){\n    ed('consent', val);\n    var a=$('cs-agree'), d=$('cs-decline');\n    if(a)a.classList.toggle('on', val==='yes'); if(d)d.classList.toggle('on', val==='no');\n    var note=$('cs-note'); if(note){ note.textContent=(val==='yes')?'Thank you. Click the arrow below to begin.':'You have declined. Click the arrow below to exit the study.'; }\n    unlock();\n  }\n  var a=$('cs-agree'); if(a)a.addEventListener('click',function(){ choose('yes'); });\n  var d=$('cs-decline'); if(d)d.addEventListener('click',function(){ choose('no'); });\n});\n"}}, {"SurveyID": "SV_b14WSROVHHjCJO8", "Element": "SQ", "PrimaryAttribute": "QID3", "SecondaryAttribute": "Browser meta", "TertiaryAttribute": null, "Payload": {"QuestionText": "Browser Meta Info", "QuestionText_Unsafe": "Browser Meta Info", "QuestionType": "Meta", "Selector": "Browser", "DataExportTag": "browser_meta", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Browser meta", "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID3", "Choices": {"1": {"Display": "Browser", "TextEntry": 1}, "2": {"Display": "Version", "TextEntry": 1}, "3": {"Display": "Operating System", "TextEntry": 1}, "4": {"Display": "Screen Resolution", "TextEntry": 1}, "5": {"Display": "Flash Version", "TextEntry": 1}, "6": {"Display": "Java Support", "TextEntry": 1}, "7": {"Display": "User Agent", "TextEntry": 1}}}}, {"SurveyID": "SV_b14WSROVHHjCJO8", "Element": "SQ", "PrimaryAttribute": "QID4", "SecondaryAttribute": "Instructions", "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style='max-width:720px;margin:0 auto;font-size:15px;line-height:1.65;color:#222'><h3>How this task works</h3><p>This is a short study about how people read product options. On each of the next nine pages you will see one shopping scenario with two options; imagine you are really shopping, and choose the <b>one</b> option you would pick. Each page is a different product. After the choices you will answer a few quick questions about some further sets of options, and rate a few product pages.</p><p>There are no right or wrong answers. Please read each option's details before answering. Click the arrow to begin.</p></div>", "QuestionText_Unsafe": "<div style='max-width:720px;margin:0 auto;font-size:15px;line-height:1.65;color:#222'><h3>How this task works</h3><p>This is a short study about how people read product options. On each of the next nine pages you will see one shopping scenario with two options; imagine you are really shopping, and choose the <b>one</b> option you would pick. Each page is a different product. After the choices you will answer a few quick questions about some further sets of options, and rate a few product pages.</p><p>There are no right or wrong answers. Please read each option's details before answering. Click the arrow to begin.</p></div>", "DataExportTag": "instructions", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Instructions", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID4"}}, {"SurveyID": "SV_b14WSROVHHjCJO8", "Element": "SQ", "PrimaryAttribute": "QID5", "SecondaryAttribute": "Attention check", "TertiaryAttribute": null, "Payload": {"QuestionText": "To show you are reading carefully, please select <b>“Strongly agree”</b> below, regardless of your actual opinion.", "QuestionText_Unsafe": "To show you are reading carefully, please select <b>“Strongly agree”</b> below, regardless of your actual opinion.", "DataExportTag": "attention_1", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Attention check", "Choices": {"1": {"Display": "Strongly disagree"}, "2": {"Display": "Disagree"}, "3": {"Display": "Neither agree nor disagree"}, "4": {"Display": "Agree"}, "5": {"Display": "Strongly agree"}}, "ChoiceOrder": ["1", "2", "3", "4", "5"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 6, "NextAnswerId": 1, "QuestionID": "QID5"}}, {"SurveyID": "SV_b14WSROVHHjCJO8", "Element": "SQ", "PrimaryAttribute": "QID6", "SecondaryAttribute": "Timer page 1", "TertiaryAttribute": null, "Payload": {"QuestionText": "Timing", "QuestionText_Unsafe": "Timing", "QuestionType": "Timing", "Selector": "PageTimer", "DataExportTag": "timer_1", "Configuration": {"MaxSeconds": "0", "MinSeconds": "0", "QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Timer page 1", "Validation": null, "GradingData": [], "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "DefaultChoices": false, "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID6", "Choices": {"1": {"Display": "First Click"}, "2": {"Display": "Last Click"}, "3": {"Display": "Page Submit"}, "4": {"Display": "Click Count"}}}}, {"SurveyID": "SV_b14WSROVHHjCJO8", "Element": "SQ", "PrimaryAttribute": "QID7", "SecondaryAttribute": "Choice slot 1 (backpacks)", "TertiaryAttribute": null, "Payload": {"QuestionText": 