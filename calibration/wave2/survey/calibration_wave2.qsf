'); if(g&&g.parentNode)g.parentNode.removeChild(g);\n    try{self.showNextButton();}catch(e){}\n    var nb=document.getElementById('NextButton'); if(nb){nb.style.display='';nb.style.visibility='';nb.style.pointerEvents='';nb.removeAttribute('disabled');}\n    setTimeout(function(){try{self.showNextButton();}catch(e){}},120); }\n  var rawO=($('cfx-optsdata-'+T)||{}).value||'[]';\n  var stem=($('cfx-stemdata-'+T)||{}).value||'';\n  var img=($('cfx-imgdata-'+T)||{}).value||'';\n  if(img){ img=HB+'/'+img.split('/').pop(); }\n  var opts; try{opts=JSON.parse(rawO);}catch(e){opts=[];}\n  if(!opts.length){ var er=$('cfx-err-'+T); if(er)er.style.display='block'; return; }\n  $('cfx-stem-'+T).innerHTML=stem;\n  var im=$('cfx-img-'+T);\n  if(img && im){ im.src=img; im.style.display='block'; }\n  var wrap=$('cfx-opts-'+T);\n  opts.forEach(function(o,i){\n    var card=document.createElement('label'); card.className='cfx-card'+(o.available===false?' cfx-un':'');\n    if(o.available===false){ card.innerHTML=o.html+\"<span class='cfx-badge'>currently unavailable</span>\"; }\n    else {\n      card.innerHTML=\"<input type='radio' name='cfx-\"+T+\"' value='\"+(i+1)+\"'>\"+o.html;\n      card.querySelector('input').addEventListener('change',function(){\n        ed('choice_'+T, String(i+1)); ed('choice_'+T+'_code', o.code);\n        var cs=wrap.querySelectorAll('.cfx-card'); for(var k=0;k<cs.length;k++){cs[k].classList.remove('sel');}\n        card.classList.add('sel'); unlock();\n      });\n    }\n    wrap.appendChild(card);\n  });\n});\n"}}, {"SurveyID": "SV_ClMSB8rpyJXsFak", "Element": "SQ", "PrimaryAttribute": "QID8", "SecondaryAttribute": "Timer page 2", "TertiaryAttribute": null, "Payload": {"QuestionText": "Timing", "QuestionText_Unsafe": "Timing", "QuestionType": "Timing", "Selector": "PageTimer", "DataExportTag": "timer_2", "Configuration": {"MaxSeconds": "0", "MinSeconds": "0", "QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Timer page 2", "Validation": null,