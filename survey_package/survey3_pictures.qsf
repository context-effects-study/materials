/Field/cell3_stem}</textarea><textarea id='cfx-optsdata-3' style='display:none'>${e://Field/cell3_options}</textarea><textarea id='cfx-imgdata-3' style='display:none'>${e://Field/cell3_image}</textarea>","DataExportTag":"choice_3_q","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Choice page 3","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"DefaultChoices":false,"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID11","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function(){});\nQualtrics.SurveyEngine.addOnReady(function(){\n  var self=this, T=3;\n  var HB=\"https://context-effects-fidelity.pages.dev/img\";\n  function ed(k,v){ try{ Qualtrics.SurveyEngine.setEmbeddedData(k,v); }catch(e){} }\n  function $(id){ return document.getElementById(id); }\n  self.hideNextButton();\n  var gs=document.createElement('style'); gs.id='cfx-gate-3';\n  gs.textContent='#NextButton,input[id=\\\"NextButton\\\"]{display:none !important;visibility:hidden !important;pointer-events:none !important;}#PreviousButton{display:none !important;}';\n  document.head.appendChild(gs); var done=false;\n  var obs=new MutationObserver(function(){ if(done)return; if(!document.getElementById('cfx-gate-3'))document.head.appendChild(gs); });\n  try{ obs.observe(document.head,{childList:true}); }catch(e){}\n  setTimeout(function(){ if(!done)self.hideNextButton(); },500);\n  setTimeout(function(){ if(!done)self.hideNextButton(); },2000);\n  function unlock(){ if(done)return; done=true; try{obs.disconnect();}catch(e){}\n    var g=document.getElementById('cfx-gate-3'); if(g&&g.parentNode)g.parentNode.removeChild(g);\n    try{self.showNextButton();}catch(e){}\n    var nb=document.getElementById('NextButton'); if(nb){nb.style.display='';nb.style.visibility='';nb.style.pointerEvents='';nb.removeAttribute('disabled');}\n    setTimeout(function(){try{self.showNextButton();}catch(e){}},120); }\n  var rawO=($('cfx-optsdata-'+T)||{}).value||'[]';\n  var stem=($('cfx-stemdata-'+T)||{}).value||'';\n  var img=($('cfx-imgdata-'+T)||{}).value||'';\n  if(img){ img=HB+'/'+img.split('/').pop(); }\n  var opts; try{opts=JSON.parse(rawO);}catch(e){opts=[];}\n  if(!opts.length||!img){ var er=$('cfx-err-'+T); if(er)er.style.display='block'; return; }\n  $('cfx-stem-'+T).innerHTML=stem;\n  var im=$('cfx-img-'+T); if(im){ im.src=img; }\n  var wrap=$('cfx-opts-'+T);\n  opts.forEach(function(o,i){\n    var card=document.createElement('label'); card.className='cfx-card';\n    card.innerHTML=\"<input type='radio' name='cfx-\"+T+\"' value='\"+(i+1)+\"'>\"+o.html;\n    card.querySelector('input').addEventListener('change',function(){\n      ed('choice_'+T, String(i+1)); ed('choice_'+T+'_code', o.code);\n      var cs=wrap.querySelectorAll('.cfx-card'); for(var k=0;k<cs.length;k++){cs[k].classList.remove('sel');}\n      card.classList.add('sel'); unlock();\n    });\n    wrap.appendChild(card);\n  });\n});\n"}},{"SurveyID":"SV_ynjiYG80N2rpyx5","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Gender","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your gender?","QuestionText_Unsafe":"What is your gender?","DataExportTag":"gender","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Gender","Choices":{"1":{"Display":"Woman"},"2":{"Display":"Man"},"3":{"Display":"Non-binary"},"4":{"Display":"Prefer not to say"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"DefaultChoices":false,"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID12"}},{"SurveyID":"SV_ynjiYG80N2rpyx5","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Age","TertiaryAttribute":null,"Payload":{"QuestionText":"